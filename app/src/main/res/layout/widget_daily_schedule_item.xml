<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_item_root"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@drawable/widget_daily_item_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="5dp">

    <TextView
        android:id="@+id/daily_item_time"
        android:layout_width="82dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/daily_item_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/daily_item_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#DAD5FF"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/daily_item_pending"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/daily_item_now"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_now_background"
        android:paddingHorizontal="5dp"
        android:paddingVertical="2dp"
        android:text="AHORA"
        android:textColor="#FFFFFF"
        android:textSize="8sp"
        android:textStyle="bold" />
</LinearLayout>
